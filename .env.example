# ── Core Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-key
WTF_CSRF_SECRET_KEY=replace-with-a-random-secret-key


# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///data.sqlite


# ── LLM (Anthropic) ────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=your-model-name


# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
MAIL_DEFAULT_SENDER=your-email@example.com


# ── Celery / Redis ─────────────────────────────────────────
# Broker uses Redis database 0; results use database 1.
#
# Local development:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ── External URL building ──────────────────────────────────
SERVER_NAME=localhost:5001
PREFERRED_URL_SCHEME=http


# ── Worker role ─────────────────────────────────────────────
# Email-only workers can set this to 0 to skip loading ML models.
LOAD_MODELS=1


# ── Email safety ────────────────────────────────────────────
# Keep 0 normally; the live-worker email integration test runs the worker with =1
# The live-worker email integration test can override it when needed.
MAIL_SUPPRESS_SEND=0


# ── Proxy configuration ────────────────────────────────────
# 0 = no proxy, such as local development.
# 1 = one nginx/PaaS router/ALB.
# 2 = Cloudflare -> nginx.
#
# Set this from the real deployment environment by counting
# trusted X-Forwarded-For proxy hops.
TRUSTED_PROXY_HOPS=0

# ── Lifetime analysis quota ───────────────────────────────────
# Lifetime analyses per user. This is the cost cap — each one
# triggers roughly six paid LLM calls.
ANALYSIS_LIFETIME_QUOTA=3