# Copy this file to .env and fill in the required values:
# cp .env.example .env
#
# Generate SECRET_KEY and WTF_CSRF_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Core Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-key
WTF_CSRF_SECRET_KEY=replace-with-a-random-secret-key

# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///data.sqlite

# ── LLM (Anthropic) ────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=your-model-name

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
MAIL_DEFAULT_SENDER=your-verified-sender@example.com

# ── Celery / Redis ─────────────────────────────────────────
# Broker uses Redis database 0, results use database 1, and rate limiting uses database 2.
#
# Local development:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
RATELIMIT_STORAGE_URI=redis://localhost:6379/2

# ── External URL building ──────────────────────────────────
SERVER_NAME=localhost:5001
PREFERRED_URL_SCHEME=http

# ── Worker role ─────────────────────────────────────────────
# Email-only workers can set this to 0 to skip loading ML models.
LOAD_MODELS=1

# ── Email safety ────────────────────────────────────────────
# Keep 0 normally; the live-worker email integration test runs the worker with =1
# The live-worker email integration test can override it when needed.
MAIL_SUPPRESS_SEND=0

# ── Proxy configuration ────────────────────────────────────
# Client IP and request scheme use separate trust rules:
#
# CLIENT_IP_SOURCE         -> client IP
# TRUSTED_PROXY_PROTO_HOPS -> http/https scheme
#
# CLIENT_IP_SOURCE:
# remote-addr = use the socket peer and ignore forwarded client-IP headers.
#               Safe default when Flask is reached directly.
#
# cf-connecting-ip = use Cloudflare's CF-Connecting-IP, but ONLY when the
#                    request proves it passed through our Cloudflare ingress.
#
# Cloudflare must overwrite X-Interview-Intel-Origin with CF_ORIGIN_SECRET on
# every forwarded request. The app trusts CF-Connecting-IP only when that
# secret matches; otherwise it falls back to the socket peer.
#
# Production (Cloudflare -> Railway -> app) uses cf-connecting-ip.
# Live measurements showed CF-Connecting-IP contains the real client IP while
# X-Forwarded-For may begin with a Cloudflare edge address. Therefore client-IP
# resolution does not use X-Forwarded-For or X-Real-IP. The old xff-leftmost
# mode is rejected. See ADR-0012.
#
# CF_ORIGIN_SECRET:
# Required only with CLIENT_IP_SOURCE=cf-connecting-ip. Startup fails if it is
# missing or shorter than 32 characters. Configure the SAME value in a
# Cloudflare Request Header Transform rule that overwrites:
#
#     X-Interview-Intel-Origin
#
# Never commit or log the real secret. Leave it unset locally.
# CF_ORIGIN_SECRET=
#
# TRUSTED_PROXY_PROTO_HOPS:
# 0 = trust no X-Forwarded-Proto value; use the real connection scheme.
# 1 = trust one value from the nearest TLS terminator.
#
# ProxyFix reads X-Forwarded-Proto from the right, so Cloudflare sitting in
# front of Railway does not increase this value: production remains 1.
# Setting it too high can leave request.is_secure false on HTTPS requests and
# disable Flask-WTF's strict HTTPS CSRF referer check.
#
# Local development uses the safe no-proxy defaults below.
CLIENT_IP_SOURCE=remote-addr
TRUSTED_PROXY_PROTO_HOPS=0

# ── Lifetime analysis quota ───────────────────────────────────
# Lifetime analyses per user. This is the cost cap — each one
# triggers roughly six paid LLM calls.
ANALYSIS_LIFETIME_QUOTA=3