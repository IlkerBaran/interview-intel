# Copy this file to .env and fill in the required values:
# cp .env.example .env
#
# Generate SECRET_KEY and WTF_CSRF_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Core Flask ──────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-key
WTF_CSRF_SECRET_KEY=replace-with-a-random-secret-key

# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite:///data.sqlite

# ── LLM (Anthropic) ────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=your-model-name

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
MAIL_DEFAULT_SENDER=your-verified-sender@example.com

# ── Celery / Redis ─────────────────────────────────────────
# Broker uses Redis database 0, results use database 1, and rate limiting uses database 2.
#
# Local development:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
RATELIMIT_STORAGE_URI=redis://localhost:6379/2

# ── External URL building ──────────────────────────────────
SERVER_NAME=localhost:5001
PREFERRED_URL_SCHEME=http

# ── Worker role ─────────────────────────────────────────────
# Email-only workers can set this to 0 to skip loading ML models.
LOAD_MODELS=1

# ── Email safety ────────────────────────────────────────────
# Keep 0 normally; the live-worker email integration test runs the worker with =1
# The live-worker email integration test can override it when needed.
MAIL_SUPPRESS_SEND=0

# ── Proxy configuration ────────────────────────────────────
# These settings are separate because they trust different headers:
# CLIENT_IP_SOURCE reads X-Forwarded-For for the client IP.
# TRUSTED_PROXY_PROTO_HOPS reads X-Forwarded-Proto for http/https.
#
# CLIENT_IP_SOURCE:
# remote-addr = use the socket peer and ignore X-Forwarded-For.
# Use this when Flask is reached directly.
#
# xff-leftmost = trust the first X-Forwarded-For value.
# Use only when the proxy overwrites client-supplied XFF.
#
# Railway uses xff-leftmost because its edge replaces incoming XFF and puts the
# real client IP first. A fixed XFF hop count is unsafe because Railway's chain
# length can vary by routing path. See ADR-0012.
#
# Never use xff-leftmost if Flask can be reached directly, because clients could
# spoof X-Forwarded-For and bypass IP-based rate limiting.
#
# TRUSTED_PROXY_PROTO_HOPS:
# 0 = no proxy; use the real connection scheme.
# 1 = trust one TLS terminator, such as Railway, nginx, or an ALB.
#
# Keep this separate from XFF length. Railway sends one trusted proto value:
# https. Setting this too high can make request.is_secure false and weaken
# Flask-WTF's HTTPS CSRF referer check.
#
# Local development uses the defaults below because nothing sits in front of Flask.
CLIENT_IP_SOURCE=remote-addr
TRUSTED_PROXY_PROTO_HOPS=0

# ── Lifetime analysis quota ───────────────────────────────────
# Lifetime analyses per user. This is the cost cap — each one
# triggers roughly six paid LLM calls.
ANALYSIS_LIFETIME_QUOTA=3