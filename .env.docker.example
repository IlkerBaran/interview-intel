# Copy this file to .env.docker and fill in the required values:
# cp .env.docker.example .env.docker
#
# Run Compose with:
# docker compose --env-file .env.docker up
#
# Generate SECRET_KEY and WTF_CSRF_SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

# PostgreSQL
# Used by the Postgres container during initialization.
POSTGRES_PASSWORD=change-me-local-only

# ── Core Flask ──────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret-key
WTF_CSRF_SECRET_KEY=replace-with-a-random-secret-key

# ── Database ────────────────────────────────────────────────
# `db` is the PostgreSQL service name inside Docker Compose.
# Keep the password here in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://interview:change-me-local-only@db:5432/interview_intel

# ── Celery / Redis ─────────────────────────────────────────
# `redis` is the Redis service name inside Docker Compose.
# Separate Redis databases are used for Celery and rate limiting.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RATELIMIT_STORAGE_URI=redis://redis:6379/2

# ── External services ──────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
RESEND_API_KEY=your-resend-api-key
MAIL_DEFAULT_SENDER=your-verified-sender@example.com

# ── External URL building ──────────────────────────────────
SERVER_NAME=localhost:8000
PREFERRED_URL_SCHEME=http

# ── Proxy configuration ────────────────────────────────────
# Local Docker has no proxy: Compose exposes the web container directly,
# so forwarded headers must not be trusted.

# Both settings must be present, even when disabled, because ProductionConfig
# refuses to start if either is unset (ADR-0012).

# CLIENT_IP_SOURCE controls client IP handling from X-Forwarded-For.
# TRUSTED_PROXY_PROTO_HOPS controls scheme handling from X-Forwarded-Proto.

# Railway uses xff-leftmost and 1. XFF uses position because Railway's chain
# length can vary; proto uses one trusted hop from the right (TLS terminator).
# See .env.example for details.
CLIENT_IP_SOURCE=remote-addr
TRUSTED_PROXY_PROTO_HOPS=0

# LOAD_MODELS is set per service in compose.yaml:
# web=0, migrate=0, worker-email=0, worker-ml=1